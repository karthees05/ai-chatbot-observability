{
  "target": {
    "url": "http://127.0.0.1:8766/v1/chat/completions",
    "protocol": "chat_completions",
    "body": {
      "model": "nltk-eliza"
    },
    "response_path": "choices.0.message.content",
    "timeout": 10
  },
  "backends": [
    "python_lib",
    "ragas_framework",
    "judge_llm"
  ],
  "metrics": [
    "f1",
    "bleu",
    "gleu",
    "rouge",
    "meteor",
    "string_checker"
  ],
  "threshold": 4,
  "fail_on_skip": true,
  "attach_evidence": true,
  "python_lib": {
    "engine": "local"
  },
  "ragas_framework": {
    "python_lib": {
      "engine": "local"
    }
  },
  "judge_llm": {
    "python_lib": {
      "engine": "local"
    }
  }
}
