{
  "target": {
    "url": "http://127.0.0.1:8767/chat",
    "response_path": "response",
    "timeout": 180,
    "evidence_paths": {
      "contexts": "contexts",
      "retrieved_documents": "retrieved_documents",
      "tool_calls": "tool_calls",
      "tool_definitions": "tool_definitions"
    }
  },
  "backends": [
    "python_lib",
    "judge_llm",
    "ragas_framework"
  ],
  "metrics": [
    "coherence",
    "fluency",
    "similarity",
    "f1",
    "bleu",
    "gleu",
    "rouge",
    "meteor",
    "retrieval",
    "document_retrieval",
    "groundedness",
    "groundedness_pro",
    "relevance",
    "response_completeness",
    "hate_unfairness",
    "sexual",
    "violence",
    "self_harm",
    "content_safety",
    "protected_material",
    "code_vulnerability",
    "ungrounded_attributes",
    "intent_resolution",
    "task_adherence",
    "tool_call_accuracy",
    "model_labeler",
    "string_checker",
    "text_similarity",
    "indirect_attack",
    "direct_attack",
    "custom",
    "model_scorer"
  ],
  "threshold": 3,
  "attach_evidence": true,
  "python_lib": {
    "engine": "local",
    "judge": {
      "url": "http://127.0.0.1:11435/v1/chat/completions",
      "model": "qwen2.5:0.5b",
      "body": {
        "temperature": 0,
        "response_format": {
          "type": "json_schema",
          "json_schema": {
            "name": "evaluation",
            "strict": true,
            "schema": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "reason": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "score",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "max_tokens": 768
      },
      "timeout": 180,
      "python_lib": {
        "engine": "local",
        "custom_evaluator": {
          "callable": "examples.custom_evaluator:grade",
          "min": 0,
          "max": 1
        }
      }
    },
    "custom_evaluator": {
      "callable": "examples.custom_evaluator:grade",
      "min": 0,
      "max": 1
    }
  },
  "judge_llm": {
    "url": "http://127.0.0.1:11435/v1/chat/completions",
    "model": "qwen2.5:0.5b",
    "body": {
      "temperature": 0,
      "response_format": {
        "type": "json_schema",
        "json_schema": {
          "name": "evaluation",
          "strict": true,
          "schema": {
            "type": "object",
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "reason": {
                "type": "string",
                "maxLength": 240
              }
            },
            "required": [
              "score",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "max_tokens": 768
    },
    "timeout": 180,
    "python_lib": {
      "engine": "local",
      "custom_evaluator": {
        "callable": "examples.custom_evaluator:grade",
        "min": 0,
        "max": 1
      }
    }
  },
  "ragas_framework": {
    "llm": {
      "model": "qwen2.5:0.5b",
      "base_url": "http://127.0.0.1:11435/v1",
      "api_key": "ollama",
      "timeout": 180,
      "max_tokens": 1536,
      "temperature": 0,
      "max_retries": 1
    },
    "timeout": 180,
    "embeddings": {
      "model": "nomic-embed-text",
      "base_url": "http://127.0.0.1:11435/v1",
      "api_key": "ollama",
      "check_embedding_ctx_length": false,
      "request_timeout": 180,
      "max_retries": 1
    },
    "python_lib": {
      "engine": "local",
      "judge": {
        "url": "http://127.0.0.1:11435/v1/chat/completions",
        "model": "qwen2.5:0.5b",
        "body": {
          "temperature": 0,
          "response_format": {
            "type": "json_schema",
            "json_schema": {
              "name": "evaluation",
              "strict": true,
              "schema": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "required": [
                  "score",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "max_tokens": 768
        },
        "timeout": 180,
        "python_lib": {
          "engine": "local",
          "custom_evaluator": {
            "callable": "examples.custom_evaluator:grade",
            "min": 0,
            "max": 1
          }
        }
      },
      "custom_evaluator": {
        "callable": "examples.custom_evaluator:grade",
        "min": 0,
        "max": 1
      }
    }
  },
  "run_name": "Local full catalog",
  "fail_on_skip": false
}
